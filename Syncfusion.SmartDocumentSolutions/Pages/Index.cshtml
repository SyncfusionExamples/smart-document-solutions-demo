<script>
    (function () {
        // ------------------------------------------------------------------
        // Home page - tile selection.
        //
        // Behaviour:
        //   * Click a tile -> update the root data-active-tile
        //     attribute (CSS handles the visual selection ring),
        //     show the matching flagship panel, and show the
        //     matching detail panel. No navigation.
        //   * Navigation to a workspace is handled by the
        //     explicit "Open workspace" anchor inside the tile
        //     body, and by the "Open ... workspace &rarr;" CTA
        //     in the detail-panel footer. The tile <button>
        //     never navigates, so clicking anywhere outside
        //     the explicit CTA simply selects the scenario.
        //
        // The script is intentionally small and self-contained
        // so the home page does not depend on the Claim Intake
        // client module (~ 2500 lines of stateful code that
        // we do not want to load on the gallery).
        //
        // First we tag <body> with the .home-page class. The
        // global stylesheet pins <body> to overflow:hidden so
        // the Claim Intake workflow never manages page scroll;
        // that breaks the home page. We pair the body class
        // with a :has() selector in home.css so modern
        // browsers always get the override, and the JS class
        // is a safety net for browsers without :has().
        // ------------------------------------------------------------------
        document.body.classList.add('home-page');

        var root = document.querySelector('.home-root');
        if (!root) { return; }
        var tiles = Array.prototype.slice.call(root.querySelectorAll('.home-tile'));
        var details = Array.prototype.slice.call(root.querySelectorAll('.home-detail'));
        var flagships = Array.prototype.slice.call(root.querySelectorAll('.home-flagship'));

        function setActive(tile) {
            if (!tile) { return; }
            var key = tile.getAttribute('data-tile') || '';

            // Update the root state + visual selection.
            root.setAttribute('data-active-tile', key);
            tiles.forEach(function (t) {
                t.setAttribute('aria-checked', t === tile ? 'true' : 'false');
            });

            // Show the matching flagship panel, hide the rest. The
            // flagship tile now has one variant per scenario so the
            // (currently large) left card always reflects the user's
            // selection without keeping Claims Intake pinned.
            flagships.forEach(function (f) {
                var matches = f.getAttribute('data-flagship') === key;
                if (matches) { f.removeAttribute('hidden'); }
                else { f.setAttribute('hidden', ''); }
            });

            // Show the matching detail panel, hide the rest.
            details.forEach(function (d) {
                var matches = d.getAttribute('data-detail') === key;
                if (matches) { d.removeAttribute('hidden'); }
                else { d.setAttribute('hidden', ''); }
            });
            // Selection only - never navigate from here. The
            // explicit "Open workspace" anchors inside the
            // tile body and the detail-panel footer are the
            // sole navigation triggers.
        }

        tiles.forEach(function (tile) {
            tile.addEventListener('click', function (event) {
                // <a> children inside the detail footer are
                // responsible for the actual navigation; we
                // do not want to swallow their click.
                if (event.target.closest && event.target.closest('a')) {
                    return;
                }
                event.preventDefault();
                setActive(tile);
            });

            tile.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    setActive(tile);
                }
            });
        });

        // Default selection: Claims Intake so the detail panel
        // is populated on first paint without forcing the user
        // to click a card. Selection is pure visual state;
        // the user must click an explicit "Open workspace"
        // anchor to navigate to a workspace.
        var defaultTile = root.querySelector('[data-tile="claims-intake"]');
        if (defaultTile) {
            // Mark as selected visually without triggering a
            // navigation side effect.
            root.setAttribute('data-active-tile', 'claims-intake');
            defaultTile.setAttribute('aria-checked', 'true');
        }
    })();
</script>
