@page "/"
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "_Layout";
    ViewData["Title"] = "Smart Document Solutions";
    var appBasePath = HttpContextAccessor.HttpContext?.Request.PathBase.Value?.TrimEnd('/') ?? string.Empty;
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<!--
    Smart Document Solutions - home page (gallery).

    This is a standalone landing surface that does not depend
    on the ClaimIntake client module (~/js/claimIntake.js).
    Behaviour:
      * Clicking a tile (flagship or compact) only updates
        the in-page selection state via .home-root's
        data-active-tile. The flagship card and the detail
        panel below the cards both swap to show the chosen
        scenario. No navigation, no server round-trip.
      * Navigation to a workspace is intentionally EXPLICIT:
        the user must click the "Open workspace" link inside
        the flagship tile, or the "Open ... workspace &rarr;"
        CTA in the detail-panel footer. Today those CTAs
        point at /claim-intake and /contract-review.
      * Tiles that have no live workspace yet (Invoice
        batch, Board pack) keep the disabled CTA in the
        detail footer.
-->
